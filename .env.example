# JARVIS Ecommerce OS — configuration (copier en .env ; JAMAIS committer de secrets)
APP_ENV=development
LOG_LEVEL=INFO

# Postgres (optionnel en dev : sans DATABASE_URL, la persistance est désactivée)
DATABASE_URL=postgresql+psycopg2://jarvis:jarvis@localhost:5432/jarvis

# Redis / workers (optionnel : sans REDIS_URL, les jobs tournent en in-process)
REDIS_URL=redis://localhost:6379/0

# --- Fournisseurs (aucune donnée inventée : sans credentials => connector UNAVAILABLE) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
EPROLO_API_KEY=

# --- Shopify (par boutique : voir docs) ---
# SHOPIFY__kim__DOMAIN=kimberlywexlerseo.fr
# SHOPIFY__kim__TOKEN=

# --- KimberlyWexlerSEO connector ---
KWSEO_BASE_URL=
KWSEO_TOKEN=

# --- LLM (extraction/normalisation assistée ; optionnel) ---
ANTHROPIC_API_KEY=
JARVIS_LLM_MODEL=claude-opus-4-8

# --- Multi-Model Router (spec §12,§13) : APIs officielles, clés = secrets Railway ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Override du catalogue de modèles (JSON, fusion par "provider:model") — optionnel :
# MODEL_CATALOG_JSON=[{"provider":"openai","model":"gpt-5","cost_in":4.0}]
